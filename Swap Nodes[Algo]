#
# Complete the 'swapNodes' function below.
#
# The function is expected to return a 2D_INTEGER_ARRAY.
# The function accepts following parameters:
#  1. 2D_INTEGER_ARRAY indexes
#  2. INTEGER_ARRAY queries
#


def swapNodes(indexes, queries):
    # Step 1: Calculate depths using BFS
    depths = {1: 1}  
    queue = [1]

   
    while queue:
        curr = queue.pop(0)
        curr_depth = depths[curr]
        left, right = indexes[curr - 1]
        
        if left != -1:
            depths[left] = curr_depth + 1
            queue.append(left)
        if right != -1:
            depths[right] = curr_depth + 1
            queue.append(right)

   # Step 2: Helper function for swapping subtrees
    def swap(node, k):
        if node == -1:
            return
        
        # If current node's depth is a multiple of k, swap its children
        if depths[node] % k == 0:
            left, right = indexes[node - 1]
            indexes[node - 1] = [right, left]
            
        # Recurse down left and right subtrees
        left, right = indexes[node - 1]
        swap(left, k)
        swap(right, k)

    # Step 3: Helper function for In-Order traversal
    def in_order(node, result):
        if node == -1:
            return
        left, right = indexes[node - 1]
        in_order(left, result)
        result.append(node)
        in_order(right, result)



if __name__ == '__main__':
    fptr = open(os.environ['OUTPUT_PATH'], 'w')

    n = int(input().strip())

    indexes = []

    for _ in range(n):
        indexes.append(list(map(int, input().rstrip().split())))

    queries_count = int(input().strip())

    queries = []

    for _ in range(queries_count):
        queries_item = int(input().strip())
        queries.append(queries_item)

    result = swapNodes(indexes, queries)

    fptr.write('\n'.join([' '.join(map(str, x)) for x in result]))
    fptr.write('\n')

    fptr.close()
